<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate">
    <meta http-equiv="Pragma" content="no-cache">
    <meta http-equiv="Expires" content="0">
    <title>Site Country - Spécial Halloween</title>
    <style>
        * {
            box-sizing: border-box;
            -webkit-tap-highlight-color: transparent;
        }
        body {
            margin: 0;
            padding: 20px;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #120f18; /* Fond sombre mystique */
            color: #f3f4f6;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            position: relative;
            overflow-x: hidden;
        }

        .pattern-bg {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: -1;
            opacity: 0.12;
            font-size: 1.8rem;
            display: flex;
            flex-wrap: wrap;
            justify-content: space-around;
            align-content: space-around;
            overflow: hidden;
        }

        /* Bande défilante en haut */
        .bande-defilante {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            background-color: #ea580c; /* Orange citrouille */
            color: #120f18;
            font-weight: bold;
            padding: 8px 0;
            overflow: hidden;
            white-space: nowrap;
            z-index: 100;
            box-shadow: 0 2px 10px rgba(234, 88, 12, 0.4);
        }
        .bande-defilante span {
            display: inline-block;
            padding-left: 100%;
            animation: defilement 15s linear infinite;
        }
        @keyframes defilement {
            0% { transform: translate(0, 0); }
            100% { transform: translate(-100%, 0); }
        }

        /* Lecteur audio flottant en bas */
        .lecteur-musique {
            position: fixed;
            bottom: 15px;
            background: rgba(26, 22, 37, 0.9);
            border: 2px solid #ea580c;
            padding: 8px 15px;
            border-radius: 30px;
            z-index: 100;
            display: flex;
            align-items: center;
            gap: 10px;
            box-shadow: 0 4px 15px rgba(234, 88, 12, 0.3);
        }
        .lecteur-musique span {
            font-size: 0.9rem;
            font-weight: bold;
            color: #fb923c;
        }
        .lecteur-musique audio {
            height: 30px;
            outline: none;
        }

        /* --- ÉCRAN ACCUEIL --- */
        #section-accueil {
            text-align: center;
            max-width: 600px;
            width: 100%;
            padding: 40px;
            background: rgba(26, 22, 37, 0.95);
            border-radius: 12px;
            box-shadow: 0 8px 24px rgba(234, 88, 12, 0.2);
            border: 2px solid #ea580c;
            margin-top: 30px;
        }
        h1 {
            font-size: 2.8rem;
            margin-bottom: 10px;
            color: #f97316;
            text-transform: uppercase;
            letter-spacing: 2px;
            text-shadow: 0 0 10px rgba(249, 115, 22, 0.5);
        }
        .bulle-sous-titre {
            font-size: 1.1rem;
            margin-bottom: 30px;
            color: #d1d5db;
            background: rgba(234, 88, 12, 0.15);
            padding: 15px;
            border-radius: 8px;
            border-left: 4px solid #ea580c;
        }
        .btn-groupe-accueil {
            display: flex;
            flex-direction: column;
            gap: 12px;
            align-items: center;
            width: 100%;
        }
        .btn-commencer, .btn-credits-ouvrir {
            background-color: #ea580c;
            color: #fff;
            padding: 14px 35px;
            font-size: 1.1rem;
            font-weight: bold;
            border: none;
            border-radius: 30px;
            cursor: pointer;
            width: 100%;
            max-width: 250px;
            box-shadow: 0 4px 10px rgba(234, 88, 12, 0.3);
            transition: background-color 0.2s;
        }
        .btn-commencer:active, .btn-credits-ouvrir:active {
            background-color: #c2410c;
            transform: scale(0.98);
        }

        /* --- MODAL CRÉDITS --- */
        #modal-credits {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.7);
            justify-content: center;
            align-items: center;
            z-index: 10;
            padding: 15px;
        }
        .credits-contenu {
            background: #1a1625;
            padding: 30px;
            border-radius: 12px;
            max-width: 500px;
            width: 100%;
            border: 2px solid #ea580c;
            box-shadow: 0 10px 25px rgba(234, 88, 12, 0.3);
            color: #f3f4f6;
            text-align: left;
        }
        .credits-contenu h3 {
            color: #f97316;
            margin-top: 0;
            text-align: center;
            text-transform: uppercase;
        }
        .credits-contenu p {
            margin: 10px 0;
            line-height: 1.5;
            color: #d1d5db;
        }
        .credits-contenu a {
            color: #fb923c;
            word-break: break-all;
        }
        .btn-fermer-credits {
            display: block;
            margin: 20px auto 0 auto;
            background-color: #ea580c;
            color: white;
            border: none;
            padding: 10px 20px;
            border-radius: 20px;
            cursor: pointer;
            font-weight: bold;
        }

        /* --- ÉCRAN CHOIX DES NIVEAUX --- */
        #section-niveaux {
            display: none;
            text-align: center;
            max-width: 600px;
            width: 100%;
            padding: 40px;
            margin-top: 30px;
        }
        #section-niveaux h2 {
            color: #f97316;
            margin-bottom: 30px;
            font-size: 1.8rem;
            text-transform: uppercase;
            text-shadow: 0 0 8px rgba(249, 115, 22, 0.4);
        }
        .menu-niveaux {
            display: flex;
            flex-direction: column;
            gap: 15px;
        }
        .btn-niveau {
            background-color: #1a1625;
            color: #f3f4f6;
            border: 2px solid #ea580c;
            padding: 15px 25px;
            font-size: 1.2rem;
            font-weight: bold;
            border-radius: 8px;
            cursor: pointer;
            box-shadow: 0 4px 6px rgba(0,0,0,0.2);
        }
        .btn-niveau:active {
            background-color: #ea580c;
            color: white;
        }

        /* --- ÉCRAN LISTE DES DANSES --- */
        #section-danses {
            display: none;
            width: 100%;
            max-width: 1000px;
            text-align: center;
            margin-top: 30px;
        }
        #section-danses h2 {
            color: #f97316;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 30px;
            font-size: 1.4rem;
            padding: 0 10px;
        }
        .grid-danses {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 20px;
            padding: 10px;
        }
        .conteneur-element-danse {
            display: flex;
            flex-direction: column;
            width: 100%;
        }
        .badge-createur {
            background-color: #ea580c;
            color: white;
            font-size: 0.8rem;
            font-weight: bold;
            padding: 5px 10px;
            border-radius: 15px 15px 0 0;
            margin-bottom: -2px;
            display: inline-block;
            align-self: center;
            box-shadow: 0 -2px 5px rgba(0,0,0,0.2);
            text-align: center;
        }
        .btn-danse {
            background-color: #1a1625;
            color: #f3f4f6;
            border: 2px solid #ea580c;
            padding: 15px 20px;
            font-size: 1rem;
            font-weight: bold;
            text-align: center;
            border-radius: 8px;
            cursor: pointer;
            box-shadow: 0 4px 6px rgba(0,0,0,0.2);
            width: 100%;
        }
        .btn-danse:active {
            background-color: #ea580c;
            color: white;
        }
        .btn-retour-niveaux {
            display: inline-block;
            margin-top: 30px;
            background-color: transparent;
            color: #fb923c;
            border: 2px solid #ea580c;
            padding: 10px 20px;
            border-radius: 5px;
            cursor: pointer;
            font-weight: bold;
        }

        /* --- ÉCRAN DÉTAIL D'UNE DANSE --- */
