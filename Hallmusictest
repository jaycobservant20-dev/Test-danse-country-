            display: none;
            text-align: center;
            max-width: 600px;
            width: 100%;
            padding: 40px;
            background: rgba(26, 22, 37, 0.95);
            border-radius: 12px;
            box-shadow: 0 8px 24px rgba(234, 88, 12, 0.2);
            border: 2px solid #ea580c;
            margin-top: 30px;
        }
        #titre-danse-selectionnee {
            color: #f97316;
            margin-bottom: 30px;
            font-size: 1.8rem;
            text-transform: uppercase;
        }
        .menu-options-danse {
            display: flex;
            flex-direction: column;
            gap: 15px;
        }
        .btn-option-danse {
            background-color: #1a1625;
            color: #f3f4f6;
            border: 2px solid #ea580c;
            padding: 15px 25px;
            font-size: 1.2rem;
            font-weight: bold;
            border-radius: 8px;
            cursor: pointer;
            box-shadow: 0 4px 6px rgba(0,0,0,0.2);
            text-decoration: none;
            display: block;
        }
        .btn-option-danse:active {
            background-color: #ea580c;
            color: white;
        }
        .btn-retour-danses {
            display: inline-block;
            margin-top: 25px;
            background-color: transparent;
            color: #fb923c;
            border: 2px solid #ea580c;
            padding: 8px 20px;
            border-radius: 5px;
            cursor: pointer;
            font-weight: bold;
        }
    </style>
</head>
